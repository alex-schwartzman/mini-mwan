msgid "Add WAN Interface"
msgstr "Добавить WAN интерфейс"

msgid "Configure WAN interfaces for multi-WAN management. Typically WireGuard tunnels (wg0, wg1, etc)."
msgstr "Настройка WAN интерфейсов для управления несколькими WAN. Обычно это туннели WireGuard (wg0, wg1 и т.д.)."

msgid "config.interface.enabled.description"
msgstr "Использовать данный WAN интерфейс для маршрутизации"

msgid "Global Settings"
msgstr "Глобальные настройки"

msgid "Lightweight multi-WAN management for WireGuard VPN tunnels with failover and load balancing support."
msgstr "Легковесное управление несколькими WAN для туннелей WireGuard VPN с поддержкой отказоустойчивости и балансировки нагрузки."

msgid "Mini Multi-WAN"
msgstr "Mini Multi-WAN"

msgid "WAN Interfaces"
msgstr "WAN интерфейсы"

msgid "WAN Interface"
msgstr "WAN интерфейс"

