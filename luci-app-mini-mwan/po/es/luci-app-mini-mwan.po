# Configuration: Global Settings
msgid "config.settings.enabled.name"
msgstr "Activar"

msgid "config.settings.enabled.description"
msgstr "Activar servicio Mini Multi-WAN. Se deben configurar al menos dos interfaces WAN."

msgid "config.settings.mode.name"
msgstr "Modo"

msgid "config.settings.mode.description"
msgstr "Modo de operación: conmutación por error (principal/respaldo) o múltiples enlaces (balanceo de carga)"

