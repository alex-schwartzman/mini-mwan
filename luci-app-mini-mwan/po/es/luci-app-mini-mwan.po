msgid "Add WAN Interface"
msgstr "Agregar interfaz WAN"

msgid "Configure WAN interfaces for multi-WAN management. Typically WireGuard tunnels (wg0, wg1, etc)."
msgstr "Configurar interfaces WAN para gestión multi-WAN. Típicamente túneles WireGuard (wg0, wg1, etc)."

msgid "config.interface.enabled.description"
msgstr "Usar esta interfaz WAN para enrutamiento"

msgid "Global Settings"
msgstr "Configuración global"

msgid "Lightweight multi-WAN management for WireGuard VPN tunnels with failover and load balancing support."
msgstr "Gestión ligera de múltiples WAN para túneles VPN WireGuard con soporte de conmutación por error y balanceo de carga."

msgid "Mini Multi-WAN"
msgstr "Mini Multi-WAN"

msgid "WAN Interfaces"
msgstr "Interfaces WAN"

msgid "WAN Interface"
msgstr "Interfaz WAN"

