msgstr "Cible de ping"

msgid "config.interface.ping_target.description"
msgstr "Adresse IP à pinguer pour vérifier la connectivité"

msgid "config.interface.ping_count.name"
msgstr "Nombre de pings"

msgid "config.interface.ping_count.description"
msgstr "Nombre de tentatives de ping"

msgid "config.interface.ping_timeout.name"
msgstr "Délai d'attente"

msgid "config.interface.ping_timeout.description"
msgstr "Délai d'attente du ping (secondes)"
