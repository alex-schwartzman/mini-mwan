msgid "Add WAN Interface"
msgstr "Ajouter une interface WAN"

msgid "Configure WAN interfaces for multi-WAN management. Typically WireGuard tunnels (wg0, wg1, etc)."
msgstr "Configurer les interfaces WAN pour la gestion multi-WAN. Typiquement des tunnels WireGuard (wg0, wg1, etc)."

msgid "config.interface.enabled.description"
msgstr "Utiliser cette interface WAN pour le routage"

msgid "Global Settings"
msgstr "Paramètres globaux"

msgid "Lightweight multi-WAN management for WireGuard VPN tunnels with failover and load balancing support."
msgstr "Gestion légère multi-WAN pour les tunnels VPN WireGuard avec support de basculement et d'équilibrage de charge."

msgid "Mini Multi-WAN"
msgstr "Mini Multi-WAN"

msgid "WAN Interfaces"
msgstr "Interfaces WAN"

msgid "WAN Interface"
msgstr "Interface WAN"

