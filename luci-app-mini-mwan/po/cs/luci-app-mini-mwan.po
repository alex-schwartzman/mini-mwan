msgid "Add WAN Interface"
msgstr "Přidat WAN rozhraní"

msgid "Check Interval"
msgstr "Interval ověřování"

msgid "How often to check WAN connectivity (seconds)"
msgstr "Jak často ověřovat připojení WAN (sekundy)"

msgid "Check with: "
msgstr "Kontrola pomocí: "

msgid "Configure WAN interfaces for multi-WAN management. Typically WireGuard tunnels (wg0, wg1, etc)."
msgstr "Nastavení WAN rozhraní pro správu více WAN. Obvykle tunely WireGuard (wg0, wg1, atd.)."

msgid "Device"
msgstr "Zařízení"

msgid "Duplicate device \"%s\" found. Each interface must use a unique device."
msgstr "Bylo nalezeno duplicitní zařízení \"%s\". Každé rozhraní musí používat jedinečné zařízení."

msgid "Enable"
msgstr "Povolit"

msgid "Enable Mini Multi-WAN service. At least two WAN interfaces must be configured."
msgstr "Povolit službu Mini Multi-WAN. Musí být nakonfigurována alespoň dvě WAN rozhraní."

msgid "config.interface.enabled.description"
msgstr "Použít toto WAN rozhraní pro směrování"

msgid "Enabled"
msgstr "Povoleno"

msgid "Failover (Primary/Backup)"
msgstr "Záložní režim (Primární/Záložní)"

msgid "Gateway"
msgstr "Brána"

msgid "Global Settings"
msgstr "Globální nastavení"

msgid "Interface"
msgstr "Rozhraní"

msgid "Interface Status"
msgstr "Stav rozhraní"

msgid "IP address to ping for connectivity check"
msgstr "IP adresa pro ověření připojení pomocí ping"

msgid "Last Check"
msgstr "Poslední ověření"

msgid "Latency"
msgstr "Latence"

msgid "Lightweight multi-WAN management for WireGuard VPN tunnels with failover and load balancing support."
msgstr "Lehká správa více WAN pro tunely WireGuard VPN s podporou záložního režimu a vyvážení zátěže."

msgid "Metric"
msgstr "Metrika"

msgid "Mini Multi-WAN"
msgstr "Mini Multi-WAN"

msgid "Mini-MWAN Status"
msgstr "Stav Mini-MWAN"

msgid "Mode"
msgstr "Režim"

msgid "Multi-Uplink (Load Balancing)"
msgstr "Více připojení (Vyvážení zátěže)"

msgid "Network interface device (e.g., wg0, wg1, eth1)"
msgstr "Síťové zařízení rozhraní (např. wg0, wg1, eth1)"

msgid "No status information available. Make sure the Mini-MWAN service is running."
msgstr "Nejsou k dispozici žádné stavové informace. Ujistěte se, že služba Mini-MWAN běží."

msgid "Number of ping attempts"
msgstr "Počet pokusů ping"

msgid "Operating mode: failover (primary/backup) or multi-uplink (load balancing)"
msgstr "Provozní režim: záložní (primární/záložní) nebo více připojení (vyvážení zátěže)"

msgid "Ping Count"
msgstr "Počet pingů"

msgid "Ping Target"
msgstr "Cíl ping"

msgid "Ping target \"%s\" is already used by another interface"
msgstr "Cíl ping \"%s\" je již používán jiným rozhraním"

msgid "Ping timeout (seconds)"
msgstr "Časový limit ping (sekundy)"

msgid "Real-time monitoring of WAN interface status"
msgstr "Monitorování stavu WAN rozhraní v reálném čase"

msgid "Route metric (lower = higher priority). Used in failover mode only."
msgstr "Metrika trasy (nižší = vyšší priorita). Používá se pouze v záložním režimu."

msgid "seconds"
msgstr "sekundy"

msgid "Service Information"
msgstr "Informace o službě"

msgid "Since"
msgstr "Od"

msgid "Status"
msgstr "Stav"

msgid "Status updates automatically every 5 seconds"
msgstr "Stav se automaticky aktualizuje každých 5 sekund"

msgid "Timeout"
msgstr "Časový limit"

msgid "Traffic (RX/TX)"
msgstr "Přenos (RX/TX)"

msgid "Traffic distribution weight for multi-uplink mode. Used in multi-uplink mode only."
msgstr "Váha distribuce přenosu pro režim více připojení. Používá se pouze v režimu více připojení."

