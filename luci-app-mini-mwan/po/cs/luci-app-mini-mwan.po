# Configuration: Global Settings
msgid "config.settings.enabled.name"
msgstr "Povolit"

msgid "config.settings.enabled.description"
msgstr "Povolit službu Mini Multi-WAN. Musí být nakonfigurována alespoň dvě WAN rozhraní."

msgid "config.settings.mode.name"
msgstr "Režim"

msgid "config.settings.mode.description"
msgstr "Provozní režim: záložní (primární/záložní) nebo více připojení (vyvážení zátěže)"

msgid "config.settings.mode.failover"
msgstr "Záložní režim (Primární/Záložní)"

