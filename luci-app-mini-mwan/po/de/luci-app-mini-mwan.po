# Configuration: Global Settings
msgid "config.settings.enabled.name"
msgstr "Aktivieren"

msgid "config.settings.enabled.description"
msgstr "Mini Multi-WAN-Dienst aktivieren. Es müssen mindestens zwei WAN-Schnittstellen konfiguriert sein."

msgid "config.settings.mode.name"
msgstr "Modus"

msgid "config.settings.mode.description"
msgstr "Betriebsmodus: Failover (Primär/Backup) oder Multi-Uplink (Lastverteilung)"

