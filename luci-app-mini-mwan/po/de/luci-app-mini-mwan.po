msgid "Add WAN Interface"
msgstr "WAN-Schnittstelle hinzufügen"

msgid "Configure WAN interfaces for multi-WAN management. Typically WireGuard tunnels (wg0, wg1, etc)."
msgstr "WAN-Schnittstellen für Multi-WAN-Verwaltung konfigurieren. Typischerweise WireGuard-Tunnel (wg0, wg1, usw.)."

msgid "config.interface.enabled.description"
msgstr "Diese WAN-Schnittstelle für Routing verwenden"

msgid "Global Settings"
msgstr "Globale Einstellungen"

msgid "Lightweight multi-WAN management for WireGuard VPN tunnels with failover and load balancing support."
msgstr "Leichtgewichtige Multi-WAN-Verwaltung für WireGuard-VPN-Tunnel mit Failover- und Load-Balancing-Unterstützung."

msgid "Mini Multi-WAN"
msgstr "Mini Multi-WAN"

msgid "WAN Interfaces"
msgstr "WAN-Schnittstellen"

msgid "WAN Interface"
msgstr "WAN-Schnittstelle"

